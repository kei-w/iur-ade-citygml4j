<?xml version="1.0" encoding="UTF-8"?>
<jaxb:bindings version="2.1" xmlns:jaxb="http://java.sun.com/xml/ns/jaxb" xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:namespace="http://jaxb2-commons.dev.java.net/namespace-prefix">
  
  <jaxb:bindings schemaLocation="schemas/urbanObject.xsd" node="/xs:schema">
    <jaxb:schemaBindings>
      <jaxb:package name="jp.geospatial.iur._2_0.uro"/>
    </jaxb:schemaBindings>
    <jaxb:bindings>
      <namespace:prefix name="uro"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='buildingIDAttribute']">
      <jaxb:factoryMethod name="BuildingIDAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='buildingDetailAttribute']">
      <jaxb:factoryMethod name="BuildingDetailAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='largeCustomerFacilityAttribute']">
      <jaxb:factoryMethod name="LargeCustomerFacilityAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='buildingDisasterRiskAttribute']">
      <jaxb:factoryMethod name="BuildingDisasterRiskAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='keyValuePairAttribute']">
      <jaxb:factoryMethod name="KeyValuePairAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='buildingDataQualityAttribute']">
      <jaxb:factoryMethod name="BuildingDataQualityAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='landUseDetailAttribute']">
      <jaxb:factoryMethod name="LandUseDetailAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='trafficVolumeAttribute']">
      <jaxb:factoryMethod name="TrafficVolumeAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='roadStructureAttribute']">
      <jaxb:factoryMethod name="RoadStructureAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='roadDataQualityAttribute']">
      <jaxb:factoryMethod name="RoadDataQualityAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='trafficAreaStructureAttribute']">
      <jaxb:factoryMethod name="TrafficAreaStructureAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='cityFurnitureDetailAttribute']">
      <jaxb:factoryMethod name="CityFurnitureDetailAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='cityFurnitureDataQualityAttribute']">
      <jaxb:factoryMethod name="CityFurnitureDataQualityAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='vegetationDataQualityAttribute']">
      <jaxb:factoryMethod name="VegetationDataQualityAttributeProperty"/>
    </jaxb:bindings>
  </jaxb:bindings>
  
  <jaxb:bindings schemaLocation="schemas/urbanFunction.xsd" node="/xs:schema">
    <jaxb:schemaBindings>
      <jaxb:package name="jp.geospatial.iur._2_0.urf"/>
    </jaxb:schemaBindings>
    <jaxb:bindings>
      <namespace:prefix name="urf"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:complexType[@name='ZoneType']//xs:element[@name='location']">
      <jaxb:property name="locationDescription"/>
    </jaxb:bindings>
    <jaxb:bindings node="//xs:element[@name='lod-1MultiCurve']" multiple="true">
      <jaxb:property name="lodMinus1MultiCurve"/>
    </jaxb:bindings>
    <jaxb:bindings node="//xs:element[@name='lod-1MultiPoint']" multiple="true">
      <jaxb:property name="lodMinus1MultiPoint"/>
    </jaxb:bindings>
    <jaxb:bindings node="//xs:element[@name='lod-1MultiSurface']" multiple="true">
      <jaxb:property name="lodMinus1MultiSurface"/>
    </jaxb:bindings>
    <jaxb:bindings node="//xs:element[@name='lod-2MultiCurve']" multiple="true">
      <jaxb:property name="lodMinus2MultiCurve"/>
    </jaxb:bindings>
    <jaxb:bindings node="//xs:element[@name='lod-2MultiPoint']" multiple="true">
      <jaxb:property name="lodMinus2MultiPoint"/>
    </jaxb:bindings>
    <jaxb:bindings node="//xs:element[@name='lod-2MultiSurface']" multiple="true">
      <jaxb:property name="lodMinus2MultiSurface"/>
    </jaxb:bindings>
  </jaxb:bindings>
  
  <jaxb:bindings schemaLocation="schemas/statisticalGrid.xsd" node="/xs:schema">
    <jaxb:schemaBindings>
      <jaxb:package name="jp.geospatial.iur._2_0.urg"/>
    </jaxb:schemaBindings>
    <jaxb:bindings>
      <namespace:prefix name="urg"/>
    </jaxb:bindings>
    <jaxb:bindings node="//xs:element[@name='lod-1MultiSurface']" multiple="true">
      <jaxb:property name="lodMinus1MultiSurface"/>
    </jaxb:bindings>
    <jaxb:bindings node="//xs:element[@name='lod-2MultiSurface']" multiple="true">
      <jaxb:property name="lodMinus2MultiSurface"/>
    </jaxb:bindings>
  </jaxb:bindings>
  
  <jaxb:bindings schemaLocation="schemas/publicTransit.xsd" node="/xs:schema">
    <jaxb:schemaBindings>
      <jaxb:package name="jp.geospatial.iur._2_0.urt"/>
    </jaxb:schemaBindings>
    <jaxb:bindings>
      <namespace:prefix name="urt"/>
    </jaxb:bindings>
    <jaxb:bindings node="//xs:complexType[@name='RouteType']">
      <jaxb:bindings node=".//xs:element[@name='description']">
        <jaxb:property name="routeDescription"/>
      </jaxb:bindings>
    </jaxb:bindings>
    <jaxb:bindings node="//xs:complexType[@name='AgencyType']">
      <jaxb:bindings node=".//xs:element[@name='name']">
        <jaxb:property name="agencyName"/>
      </jaxb:bindings>
    </jaxb:bindings>
    <jaxb:bindings node="//xs:complexType[@name='OfficeType']">
      <jaxb:bindings node=".//xs:element[@name='name']">
        <jaxb:property name="officeName"/>
      </jaxb:bindings>
    </jaxb:bindings>
  </jaxb:bindings>
  
</jaxb:bindings>