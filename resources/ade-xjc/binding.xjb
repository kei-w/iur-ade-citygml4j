<?xml version="1.0" encoding="UTF-8"?>
<jaxb:bindings version="2.1" xmlns:jaxb="http://java.sun.com/xml/ns/jaxb" xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:namespace="http://jaxb2-commons.dev.java.net/namespace-prefix">
  
  <jaxb:bindings schemaLocation="schemas/urbanObject.xsd" node="/xs:schema">
    <jaxb:schemaBindings>
      <jaxb:package name="jp.geospatial.iur._3_2.uro"/>
    </jaxb:schemaBindings>
    <jaxb:bindings>
      <namespace:prefix name="uro"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:complexType[@name='AbstractConstructionType']//xs:element[@name='boundedBy']">
      <jaxb:property name="boundedBySurface"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:complexType[@name='PublicLandType']//xs:element[@name='id']">
      <jaxb:property name="identifier"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='buildingDetailAttribute']">
      <jaxb:factoryMethod name="BuildingDetailAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='buildingIDAttribute']">
      <jaxb:factoryMethod name="BuildingIDAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='cityFurnitureDetailAttribute']">
      <jaxb:factoryMethod name="CityFurnitureDetailAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='floodingRiskAttribute']">
      <jaxb:factoryMethod name="FloodingRiskAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='indoorStoreyAttribute']">
      <jaxb:factoryMethod name="IndoorStoreyAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='landUseDetailAttribute']">
      <jaxb:factoryMethod name="LandUseDetailAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='largeCustomerFacilityAttribute']">
      <jaxb:factoryMethod name="LargeCustomerFacilityAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='pointCloud']">
      <jaxb:factoryMethod name="PointCloudProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='railwayRouteAttribute']">
      <jaxb:factoryMethod name="RailwayRouteAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='railwayTrackAttribute']">
      <jaxb:factoryMethod name="RailwayTrackAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='roadStructureAttribute']">
      <jaxb:factoryMethod name="RoadStructureAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='squareUrbanPlanAttribute']">
      <jaxb:factoryMethod name="SquareUrbanPlanAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='trackAttribute']">
      <jaxb:factoryMethod name="TrackAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='trafficAreaStructureAttribute']">
      <jaxb:factoryMethod name="TrafficAreaStructureAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='trafficVolumeAttribute']">
      <jaxb:factoryMethod name="TrafficVolumeAttributeProperty"/>
    </jaxb:bindings>
    <jaxb:bindings node="xs:element[@name='waterBodyDetailAttribute']">
      <jaxb:factoryMethod name="WaterBodyDetailAttributeProperty"/>
    </jaxb:bindings>
  </jaxb:bindings>
  
  <jaxb:bindings schemaLocation="schemas/urbanFunction.xsd" node="/xs:schema">
    <jaxb:schemaBindings>
      <jaxb:package name="jp.go.kantei.iur._1_4.urf"/>
    </jaxb:schemaBindings>
    <jaxb:bindings>
      <namespace:prefix name="urf"/>
    </jaxb:bindings>
  </jaxb:bindings>
  
  <jaxb:bindings schemaLocation="schemas/statisticalGrid.xsd" node="/xs:schema">
    <jaxb:schemaBindings>
      <jaxb:package name="jp.go.kantei.iur._1_4.urg"/>
    </jaxb:schemaBindings>
    <jaxb:bindings>
      <namespace:prefix name="urg"/>
    </jaxb:bindings>
  </jaxb:bindings>
  
  <jaxb:bindings schemaLocation="schemas/publicTransit.xsd" node="/xs:schema">
    <jaxb:schemaBindings>
      <jaxb:package name="jp.go.kantei.iur._1_4.urt"/>
    </jaxb:schemaBindings>
    <jaxb:bindings>
      <namespace:prefix name="urt"/>
    </jaxb:bindings>
    <jaxb:bindings node="//xs:complexType[@name='RouteType']">
      <jaxb:bindings node=".//xs:element[@name='description']">
        <jaxb:property name="routeDescription"/>
      </jaxb:bindings>
    </jaxb:bindings>
    <jaxb:bindings node="//xs:complexType[@name='AgencyType']">
      <jaxb:bindings node=".//xs:element[@name='name']">
        <jaxb:property name="agencyName"/>
      </jaxb:bindings>
    </jaxb:bindings>
    <jaxb:bindings node="//xs:complexType[@name='OfficeType']">
      <jaxb:bindings node=".//xs:element[@name='name']">
        <jaxb:property name="officeName"/>
      </jaxb:bindings>
    </jaxb:bindings>
  </jaxb:bindings>
  
</jaxb:bindings>